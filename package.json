{
  "name": "wow-meta-site",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "styled-components": "^6.1.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "npm run validate:generated-data && npm run validate:pipeline && npm run validate:guide-registry && npm run validate:guide-copy && npm run validate:kb-tooltips && node scripts/validate-translations.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "validate": "npm run validate:generated-data && npm run validate:pipeline && npm run validate:guide-registry && npm run validate:guide-copy && npm run validate:kb-tooltips && npm run validate:translations",
    "validate:translations": "node scripts/validate-translations.js",
    "validate:translations:strict": "node scripts/validate-translations.js --strict",
    "validate:translations:verbose": "node scripts/validate-translations.js --verbose",
    "validate:generated-data": "npm run sync-kb && node scripts/validate-generated-data.js",
    "validate:pipeline": "node scripts/validate-pipeline-structure.js",
    "validate:guide-registry": "node scripts/validate-guide-registry.js",
    "validate:guide-copy": "node scripts/validate-guide-copy.js",
    "validate:kb-tooltips": "node scripts/validate-kb-official-tooltips.js",
    "validate:kb-tooltips:online": "node scripts/validate-kb-official-tooltips.js --online",
    "validate:kb-links": "node scripts/validate-kb-official-tooltips.js --strict-links",
    "audit:current-scope": "node scripts/audit-kb-current-scope.js",
    "audit:current-scope:offline": "node scripts/audit-kb-current-scope.js --offline",
    "validate:all": "npm run validate",
    "sync-kb": "node scripts/sync-kb.js",
    "presync-kb": "echo Syncing KB from Obsidian vault...",
    "dev": "npm run sync-kb && react-scripts start"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
