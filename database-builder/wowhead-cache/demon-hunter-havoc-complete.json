                      "items": [
                        {
                          "text": "Double Check that  Initiative should be checked if playing a No-Mover Build.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Death Sweep if  Metamorphosis will drop next global and your  Demonsurge has not been used.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Death Sweep during  Essence Break.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Annihilation during  Essence Break.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Reaver's Glaive unless  Thrill of the Fight is up with 3+ seconds on duration OR either  Glaive Flurry or  Rending Strike still need to be used.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Sigil of Spite.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Felblade when buffed by  Inertia.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Vengeful Retreat.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Vengeful Retreat before a  Glaive Flurry buffed  Blade Dance/ Death Sweep.",
                          "nested": null
                        },
                        {
                          "text": "Cast  The Hunt if you do NOT have a  Reaver's Glaive charge ready.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Essence Break while in  Metamorphosis.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Annihilation and  Chaos Strike while  Immolation Aura and  Demon Soul are active.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Immolation Aura or ( Consuming Fire in  Metamorphosis) if capped at 2 charges.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Immolation Aura or ( Consuming Fire in  Metamorphosis) if you do not currently have it active and  Eye Beam is coming up within 3 seconds.",
                          "nested": null
                        },
                        {
                          "text": "Cast  The Hunt.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Death Sweep.",
                          "nested": null
                        },
                        {
                          "text": "Cast  Metamorphosis if  Eye Beam is on cooldown.",
                          "nested": null
                        },
                        {
